# =============================================================================
# Task Manager - Variables de Entorno (.env.example)
# Copia este archivo como .env para personalizar la configuración local:
#   cp .env.example .env
# =============================================================================

# --- Configuración de PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmanager
POSTGRES_TEST_DB=taskmanager_test
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Configuración del Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/taskmanager
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/taskmanager_test
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DB_MAX_RETRIES=30
DB_RETRY_INTERVAL=2

# --- Configuración del Frontend (React + Vite) ---
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --- Configuración de Pruebas de Aceptación (Selenium) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SELENIUM_HEADLESS=true
